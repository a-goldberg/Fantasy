{
  "version": 1,
  "refresh_policy": {
    "manual": true,
    "daily_when_active": true,
    "mandatory_before_draft_session": true,
    "during_draft": "Use one frozen pre-draft snapshot unless the user explicitly requests a refresh.",
    "provenance_required": [
      "source_id",
      "source_url",
      "retrieved_at",
      "source_updated_at",
      "format",
      "validation_status"
    ]
  },
  "drive_sources": [
    {
      "id": "1770nBFAh_zf4rIL7PepqrdQ0FGOFy2XLP_PiGQ7Uopg",
      "title": "DraftSheets_2026",
      "adapter": "draftsheets_displayed_name_value",
      "rule": "Use only NAME and displayed VALUE in QB, RB, WR, and TE tables."
    },
    {
      "id": "1GFljIw0L3CVLVJ3OnBrLSb81drDoND9D4rgeeVPVozk",
      "title": "Jeff Mans Superflex Rankings",
      "adapter": "overall_superflex_rankings"
    },
    {
