      "rule": "Use the latest authenticated research snapshot. Require a source, mechanism, direction, confidence, and expiration; cap each qualitative adjustment at 1.5 points."
    },
    {
      "url": "https://www.fantasyguru.com/nfl-projections-offense",
      "adapter": "offensive_projections",
      "priority": "high"
    },
    {
      "url": "https://www.fantasyguru.com/2026-fantasy-football-wide-receiver-outlooks",
      "adapter": "wr_tiers_and_outlook_tags",
      "priority": "high"
    },
    {
      "url": "https://www.fantasyguru.com/2026-rb-handcuff-grid",
      "adapter": "rb_contingency_roles",
      "priority": "high"
    },
    {
      "url": "https://www.fantasyguru.com/nfl-personnel-tendencies-2026",
      "adapter": "personnel_usage_context",
      "priority": "medium"
    },
    {
      "url": "https://www.fantasyguru.com/2026-nfl-coaching-system-breakdowns",
      "adapter": "coaching_and_scheme_context",
      "priority": "medium"
    },
    {
      "url": "https://www.fantasyguru.com/2026-offensive-line-breakdown",
      "adapter": "offensive_line_context",
      "priority": "medium"
    },
    {
      "url": "https://www.fantasyguru.com/nfl-rankings-dynasty",
      "adapter": "rookie_and_long_term_upside",
      "priority": "low_for_redraft"
    }
  ],
  "public_market_sources": [
    {
      "url": "https://fantasyfootballcalculator.com/adp/2qb/10-team/all",
      "format": "10-team 2QB",
      "adapter": "adp"
    },
    {
      "url": "https://draftwizard.fantasypros.com/football/adp/mock-drafts/overall/2qb-std-10-teams",
      "format": "10-team 2QB standard",
      "adapter": "adp_with_range"
    },
    {
      "url": "https://www.draftsharks.com/rankings/superflex",
      "format": "superflex",
      "adapter": "partial_public_rankings",
      "rule": "Use the visible public rows only and label the coverage partial. Never extrapolate hidden ranks."
    }
  ],
  "public_context_sources": [
    {
      "url": "https://www.draftsharks.com/injury-predictor",
      "adapter": "player_injury_probability_and_projected_games_missed",
      "rule": "Compare risk within position and cap the penalty at three points."
    },
    {
      "url": "https://www.draftsharks.com/nfl-rookie-model",
      "adapter": "2026_rookie_scores",
      "rule": "Use only 2026 players; increase influence gradually in later rounds."
    },
    {
      "url": "https://www.draftsharks.com/strength-of-schedule/{position}",
      "adapter": "weeks_1_through_6_position_schedule",
      "rule": "Positive values are easier. Cap the early-schedule adjustment at 2.5 points."
    },
    {
      "url": "https://www.rotowire.com/football/news.php",
      "adapter": "current_player_news",
      "rule": "Merge the current page with up to 21 dated local snapshots. Unreviewed news is research context with zero automatic adjustment."
    },
    {
      "url": "https://www.espn.com/espn/rss/nfl/news",
      "adapter": "league_news_feed",
      "rule": "Store headline, link, and timestamp; do not infer player impact without review."
    },
    {
      "url": "https://www.ourlads.com/nfldepthcharts/depthcharts.aspx",
      "adapter": "all_team_offensive_depth_charts",
      "rule": "Preserve acquisition, rookie, UDFA, and injured/inactive markers as context rather than automatic rankings."
    }
  ],
  "verified_availability_sources": [
    {
      "local_snapshot_pattern": "Analysis/source/verified_player_availability_*.json",
      "adapter": "hard_draft_eligibility_status",
      "rule": "Require explicit attributable evidence for season-long unavailability. Keep the player for provenance but exclude them from search and recommendations."
    }
  ]
}
